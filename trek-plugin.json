{
  "id": "trek-timeline",
  "name": "Trek Timeline",
  "version": "0.1.0",
  "apiVersion": 1,
  "author": "aangelisc",
  "description": "See the whole trip on one timeline: drag stays, transport and plans between days, spot gaps and clashes, and edit stay and transport dates in a spreadsheet grid.",
  "type": "trip-page",
  "trek": ">=4.0.0 <5.0.0",
  "nativeModules": false,
  "permissions": [
    "db:read:trips",
    "db:read:costs",
    "db:write:days",
    "db:write:itinerary",
    "db:write:accommodations",
    "db:write:reservations",
    "db:write:daynotes",
    "hook:trip-warning-provider"
  ],
  "settings": [
    {
      "key": "warn_missing_stays",
      "label": "Flag nights without accommodation",
      "scope": "user",
      "input_type": "checkbox",
      "default": true
    },
    {
      "key": "warn_empty_days",
      "label": "Flag days with nothing planned",
      "scope": "user",
      "input_type": "checkbox",
      "default": true
    }
  ],
  "requiredAddons": [],
  "pluginDependencies": [],
  "icon": "Sheet"
}